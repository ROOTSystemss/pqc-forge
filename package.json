{
  "name": "@rootsystems/pqc-forge",
  "version": "0.10.0",
  "description": "Nginx, HAProxy, and Apache repository-to-patch PQC migration evidence CLI",
  "type": "module",
  "bin": {
    "pqc-forge": "./bin/pqc-forge.js",
    "pqc-forge-api": "./bin/pqc-forge-api.js"
  },
  "scripts": {
    "test": "node --test test/*.test.js",
    "api": "node ./bin/pqc-forge-api.js",
    "web:install": "npm install --prefix web",
    "web:dev": "npm run dev --prefix web",
    "web:build": "npm run build --prefix web",
    "serve": "npm run web:build && npm run api",
    "demo": "node ./bin/pqc-forge.js scan ./test/fixtures/vulnerable",
    "demo:migrate": "node ./bin/pqc-forge.js migrate ./test/fixtures/vulnerable",
    "demo:breaklab": "node ./bin/pqc-forge.js breaklab ./scenarios/tls-migration-demo.json --budget 30 --seed 42 --out ./demo-output --no-fail",
    "doctor": "node ./bin/pqc-forge.js doctor",
    "lab:protocol:windows": "powershell -NoProfile -ExecutionPolicy Bypass -File ./scripts/run-protocol-lab-windows.ps1",
    "lab:protocol": "node ./bin/pqc-forge.js protocol-lab --out ./protocol-output",
    "validate:public": "node ./bin/pqc-forge.js validate-corpus ./validation/corpus.json --out ./release-output/public-validation",
    "release:check": "node ./scripts/release-check.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "UNLICENSED",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/rootsystems/pqc-forge.git"
  },
  "homepage": "https://github.com/rootsystems/pqc-forge#readme",
  "bugs": {
    "url": "https://github.com/rootsystems/pqc-forge/issues"
  },
  "keywords": [
    "post-quantum-cryptography",
    "pqc",
    "tls",
    "nginx",
    "haproxy",
    "apache",
    "migration",
    "security",
    "cryptography",
    "ml-kem",
    "x25519mlkem768"
  ],
  "author": "RootSystems",
  "dependencies": {
    "@noble/post-quantum": "0.7.1"
  }
}
