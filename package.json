{
  "name": "pqc-forge",
  "version": "0.1.0",
  "description": "Post-quantum signing (ML-DSA) and encryption (ML-KEM) CLI and library",
  "keywords": [
    "post-quantum",
    "pqc",
    "ml-dsa",
    "ml-kem",
    "dilithium",
    "kyber",
    "cli",
    "signing",
    "encryption"
  ],
  "license": "MIT",
  "author": "saiteja799",
  "type": "module",
  "bin": {
    "pqc-forge": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "!dist/**/*.test.*"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsx src/cli.ts",
    "test": "npm run build && node --test dist/keys.test.js dist/sign.test.js dist/kem.test.js dist/encrypt.test.js dist/cli.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@noble/hashes": "^1.5.0",
    "@noble/post-quantum": "^0.2.1",
    "commander": "^12.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2"
  }
}
